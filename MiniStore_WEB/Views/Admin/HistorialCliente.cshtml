@model ClienteHistorialViewModel
@{Layout="_AdminLayout";ViewData["Title"]="Historial de compras";}
<div class="admin-page-heading"><div><a class="admin-back-link" asp-action="Clientes">← Volver</a><h1>Compras de @Model.NombreCliente</h1><p>Fechas, montos y acceso al detalle de cada pedido.</p></div></div><section class="admin-panel"><table class="table admin-table"><thead><tr><th>Pedido</th><th>Fecha</th><th>Productos</th><th>Monto</th><th>Estado</th><th></th></tr></thead><tbody>@foreach(var p in Model.Pedidos){<tr><td>#@p.Consecutivo</td><td>@p.FechaPedido.ToString("dd/MM/yyyy")</td><td>@p.CantidadProductos</td><td>₡@p.Total.ToString("N2")</td><td>@p.Estado</td><td><a asp-action="DetallePedido" asp-route-id="@p.Consecutivo">Detalle</a></td></tr>}</tbody></table></section>
