@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Pedido no encontrado";
}

<section class="admin-panel text-center py-5">
    <span class="admin-kicker">Error 404</span>
    <h1 class="mt-2">Pedido no encontrado</h1>
    <p class="text-muted">
        El pedido #@ViewBag.ConsecutivoPedido no existe o ya no está disponible.
    </p>
    <div class="d-flex justify-content-center gap-3 mt-4">
        <a class="admin-primary-button" asp-action="Pedidos">Volver a pedidos</a>
        <a class="admin-secondary-button" asp-action="Clientes">Ver clientes</a>
    </div>
</section>
