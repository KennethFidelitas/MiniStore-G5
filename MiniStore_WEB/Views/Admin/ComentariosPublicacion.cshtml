@model PublicacionModel
@{Layout="_AdminLayout";ViewData["Title"]="Comentarios";var principales=Model.Comentarios.Where(c=>!c.ConsecutivoComentarioPadre.HasValue&&c.Estado).ToList();}
<div class="admin-page-heading"><div><a class="admin-back-link" asp-action="Publicaciones">← Volver al blog</a><span class="admin-kicker">Moderación</span><h1>@Model.Titulo</h1><p>Respondé como administrador o eliminá comentarios inapropiados.</p></div></div>
@if(TempData["MensajeExito"]!=null){<div class="alert alert-success">@TempData["MensajeExito"]</div>}@if(TempData["MensajeError"]!=null){<div class="alert alert-danger">@TempData["MensajeError"]</div>}
@if(!principales.Any()){<div class="admin-panel admin-empty-state">Esta publicación todavía no tiene comentarios.</div>}
@foreach(var comentario in principales){var respuestas=Model.Comentarios.Where(r=>r.ConsecutivoComentarioPadre==comentario.Consecutivo&&r.Estado).ToList();<section class="admin-panel mb-3"><div class="d-flex justify-content-between gap-3"><div><strong>@comentario.NombreAutor</strong><small class="d-block">@comentario.FechaComentario.ToString("dd/MM/yyyy HH:mm")</small><p class="mt-2 mb-0">@comentario.Contenido</p></div><form asp-action="EliminarComentario" method="post"><input type="hidden" name="idPublicacion" value="@Model.Consecutivo"/><input type="hidden" name="idComentario" value="@comentario.Consecutivo"/><button class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Eliminar este comentario y sus respuestas?')">Eliminar</button></form></div>
@foreach(var respuesta in respuestas){<div class="mt-3 ms-4 p-3 bg-light border-start border-3"><strong>Respuesta de @respuesta.NombreAutor</strong><small class="d-block">@respuesta.FechaComentario.ToString("dd/MM/yyyy HH:mm")</small><p class="mb-2">@respuesta.Contenido</p><form asp-action="EliminarComentario" method="post"><input type="hidden" name="idPublicacion" value="@Model.Consecutivo"/><input type="hidden" name="idComentario" value="@respuesta.Consecutivo"/><button class="btn btn-sm btn-link text-danger p-0">Eliminar respuesta</button></form></div>}
<form asp-action="ResponderComentario" method="post" class="mt-3"><input type="hidden" name="idPublicacion" value="@Model.Consecutivo"/><input type="hidden" name="idComentario" value="@comentario.Consecutivo"/><label class="form-label">Responder como administrador</label><div class="d-flex gap-2"><textarea name="contenido" class="form-control" rows="2" maxlength="1000" required></textarea><button class="admin-primary-button">Responder</button></div></form></section>}
