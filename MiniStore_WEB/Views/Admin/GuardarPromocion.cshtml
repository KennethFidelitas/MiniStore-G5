@model PromocionFormViewModel
@{Layout="_AdminLayout";ViewData["Title"]="Guardar promoción";}
<div class="admin-page-heading"><div><a class="admin-back-link" asp-action="Promociones">← Volver</a><h1>@(Model.Promocion.Consecutivo>0?"Editar":"Nueva") promoción</h1></div></div>
<form method="post" class="admin-product-form"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><input asp-for="Promocion.Consecutivo" type="hidden"/><section class="admin-panel"><div class="admin-form-grid"><div class="admin-field admin-field-wide"><label asp-for="Promocion.Nombre"></label><input asp-for="Promocion.Nombre" class="form-control"/></div><div class="admin-field"><label>Descuento (%)</label><input asp-for="Promocion.Porcentaje" class="form-control" min="0.01" max="90" step="0.01"/></div><div class="admin-field"><label>Producto (opcional)</label><select asp-for="Promocion.ConsecutivoProducto" class="form-select"><option value="">Ninguno</option>@foreach(var p in Model.Productos){<option value="@p.Consecutivo">@p.Nombre</option>}</select></div><div class="admin-field"><label>Categoría (opcional)</label><select asp-for="Promocion.ConsecutivoCategoria" class="form-select"><option value="">Ninguna</option>@foreach(var c in Model.Categorias){<option value="@c.Consecutivo">@c.NombreCategoria</option>}</select></div><div class="admin-field"><label>Desde</label><input asp-for="Promocion.FechaInicio" type="date" class="form-control"/></div><div class="admin-field"><label>Hasta</label><input asp-for="Promocion.FechaFin" type="date" class="form-control"/></div><div class="admin-field"><label><input asp-for="Promocion.Estado"/> Activa</label></div></div></section><div class="admin-form-actions"><a class="admin-cancel-button" asp-action="Promociones">Cancelar</a><button class="admin-primary-button">Guardar</button></div></form>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
