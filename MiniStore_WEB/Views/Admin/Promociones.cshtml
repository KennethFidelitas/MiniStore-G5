@model List<PromocionModel>
@{
    Layout = "_AdminLayout"; ViewData["Title"] = "Promociones";
}
<div class="admin-page-heading"><div><span class="admin-kicker">Ventas</span><h1>Promociones</h1><p>Descuentos automáticos por producto o categoría.</p></div><a class="admin-primary-button" asp-action="GuardarPromocion">+ Nueva promoción</a></div>
@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success">@TempData["MensajeExito"]</div>
}
@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger">@TempData["MensajeError"]</div>
}
<section class="admin-panel"><div class="table-responsive"><table class="table admin-table"><thead><tr><th>Promoción</th><th>Aplica a</th><th>Descuento</th><th>Vigencia</th><th>Estado</th><th></th></tr></thead><tbody>@foreach(var p in Model){
    <tr><td>@p.Nombre</td><td>@(p.NombreProducto ?? p.NombreCategoria)</td><td>@p.Porcentaje.ToString("0.##")%</td><td>@p.FechaInicio.ToString("dd/MM/yyyy") - @p.FechaFin.ToString("dd/MM/yyyy")</td><td>@(p.Estado ? "Activa" : "Inactiva")</td><td><a asp-action="GuardarPromocion" asp-route-id="@p.Consecutivo">Editar</a> <form asp-action="CambiarEstadoPromocion" method="post" class="d-inline"><input type="hidden" name="id" value="@p.Consecutivo" /><input type="hidden" name="accion" value="@(p.Estado ? "desactivar" : "activar")" /><button class="btn btn-link">@(p.Estado ? "Desactivar" : "Activar")</button></form></td></tr>
}
</tbody></table></div></section>