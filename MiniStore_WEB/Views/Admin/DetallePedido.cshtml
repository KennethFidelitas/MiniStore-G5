@model PedidoDetalleModel
@{Layout="_AdminLayout";ViewData["Title"]=$"Pedido #{Model.Consecutivo}";var estados=new[]{"Pendiente","Confirmado","Preparando","Enviado","Entregado","Cancelado"};}
<div class="admin-page-heading"><div><a class="admin-back-link" asp-action="Pedidos">← Volver</a><h1>Pedido #@Model.Consecutivo</h1><p>@Model.NombreCliente · @Model.CorreoElectronico</p></div></div>@if(TempData["MensajeExito"]!=null){<div class="alert alert-success">@TempData["MensajeExito"]</div>}@if(TempData["MensajeError"]!=null){<div class="alert alert-danger">@TempData["MensajeError"]</div>}
<section class="admin-panel mb-4"><form asp-action="ActualizarEstadoPedido" method="post" class="row g-3 align-items-end"><input type="hidden" name="id" value="@Model.Consecutivo"/><div class="col-md-6"><label class="form-label">Estado actual</label><select name="estado" class="form-select">@foreach(var e in estados){<option selected="@(e==Model.Estado)">@e</option>}</select></div><div class="col-md-3"><button class="admin-primary-button">Actualizar estado</button></div></form></section>
<section class="admin-panel mb-4"><h2>Productos</h2><table class="table admin-table"><thead><tr><th>Producto</th><th>Cantidad</th><th>Precio</th><th>Subtotal</th></tr></thead><tbody>@foreach(var x in Model.Productos){<tr><td>@x.NombreProducto</td><td>@x.Cantidad</td><td>₡@x.PrecioUnitario.ToString("N2")</td><td>₡@x.Subtotal.ToString("N2")</td></tr>}</tbody></table></section><section class="admin-panel"><h2>Historial de estados</h2>@foreach(var h in Model.HistorialEstados){<p><strong>@h.EstadoNuevo</strong> — @h.FechaCambio.ToString("dd/MM/yyyy HH:mm") por @(h.NombreAdministrador??"Sistema")</p>}</section>
