@model PedidoDetalleModel
@{ ViewData["Title"]=$"Pedido #{Model.Consecutivo}"; }
<section class="padding-large"><div class="container"><a asp-action="Index">← Volver a mis pedidos</a><h1 class="display-7 mt-3">Pedido #@Model.Consecutivo</h1><div class="alert alert-light border my-4"><strong>Estado actual: @Model.Estado</strong><br/>Entrega estimada: @(Model.FechaEntregaEstimada?.ToString("dd/MM/yyyy") ?? "Por confirmar")</div>
<h3>Productos</h3><div class="table-responsive"><table class="table"><thead><tr><th>Producto</th><th>Cantidad</th><th>Precio</th><th>Subtotal</th></tr></thead><tbody>@foreach(var x in Model.Productos){<tr><td>@x.NombreProducto</td><td>@x.Cantidad</td><td>₡@x.PrecioUnitario.ToString("N2")</td><td>₡@x.Subtotal.ToString("N2")</td></tr>}</tbody></table></div>
<h3 class="mt-5">Seguimiento</h3><div class="list-group">@foreach(var h in Model.HistorialEstados){<div class="list-group-item"><strong>@h.EstadoNuevo</strong><span class="float-end">@h.FechaCambio.ToString("dd/MM/yyyy HH:mm")</span><br/><small>Cambio desde @h.EstadoAnterior</small></div>}@if(!Model.HistorialEstados.Any()){<div class="list-group-item">Pedido recibido y pendiente de actualización.</div>}</div></div></section>
